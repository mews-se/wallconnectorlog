        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "time series",
          "timeColumns": ["time"],
          "rawQueryText": "SELECT ts AS time, amp_a AS \"A\", amp_b AS \"B\", amp_c AS \"C\", amp_n AS \"N\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts",
          "queryText": "SELECT ts AS time, amp_a AS \"A\", amp_b AS \"B\", amp_c AS \"C\", amp_n AS \"N\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts"
