          "refId": "A",
          "queryType": "table",
          "timeColumns": [],
          "rawQueryText": "SELECT started_at*1000 AS \"started\", duration_s AS \"duration\", energy_wh/1000.0 AS \"kWh\", peak_power_w/1000.0 AS \"peak kW\", peak_handle_c AS \"peak handle C\", CASE WHEN grid_v_n>0 THEN ROUND(grid_v_sum/grid_v_n,1) END AS \"avg grid V\" FROM session ORDER BY started_at DESC LIMIT 500",
          "queryText": "SELECT started_at*1000 AS \"started\", duration_s AS \"duration\", energy_wh/1000.0 AS \"kWh\", peak_power_w/1000.0 AS \"peak kW\", peak_handle_c AS \"peak handle C\", CASE WHEN grid_v_n>0 THEN ROUND(grid_v_sum/grid_v_n,1) END AS \"avg grid V\" FROM session ORDER BY started_at DESC LIMIT 500"
