{
  "uid": "wallconnectorlog",
  "title": "WallConnectorLog",
  "tags": ["tesla", "wall connector", "ev"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lifetime energy delivered",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "wcl-sqlite" },
      "fieldConfig": {
        "defaults": { "unit": "kwatth", "decimals": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "timeColumns": [],
          "rawQueryText": "SELECT energy_wh/1000.0 AS \"kWh\" FROM lifetime ORDER BY ts DESC LIMIT 1",
          "queryText": "SELECT energy_wh/1000.0 AS \"kWh\" FROM lifetime ORDER BY ts DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sessions recorded",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "wcl-sqlite" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "timeColumns": [],
          "rawQueryText": "SELECT COUNT(*) AS \"sessions\" FROM session WHERE is_open=0",
          "queryText": "SELECT COUNT(*) AS \"sessions\" FROM session WHERE is_open=0"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Energy logged here",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "wcl-sqlite" },
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "timeColumns": [],
          "rawQueryText": "SELECT COALESCE(SUM(energy_wh),0)/1000.0 AS \"kWh\" FROM session WHERE is_open=0",
          "queryText": "SELECT COALESCE(SUM(energy_wh),0)/1000.0 AS \"kWh\" FROM session WHERE is_open=0"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Thermal foldbacks",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "wcl-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "timeColumns": [],
          "rawQueryText": "SELECT thermal_foldbacks AS \"foldbacks\" FROM lifetime ORDER BY ts DESC LIMIT 1",
          "queryText": "SELECT thermal_foldbacks AS \"foldbacks\" FROM lifetime ORDER BY ts DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Charger state",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "wcl-sqlite" },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9,
        "legend": { "showLegend": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 0 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Booting", "color": "purple", "index": 0 },
                "1": { "text": "No vehicle connected", "color": "#6e7681", "index": 1 },
                "2": { "text": "Connected, not ready", "color": "yellow", "index": 2 },
                "4": { "text": "Connected, ready", "color": "blue", "index": 3 },
                "6": { "text": "Negotiating", "color": "orange", "index": 4 },
                "7": { "text": "Starting up", "color": "light-blue", "index": 5 },
                "8": { "text": "Charging finished", "color": "dark-green", "index": 6 },
                "9": { "text": "Waiting for vehicle", "color": "light-yellow", "index": 7 },
                "10": { "text": "Charging at reduced power", "color": "semi-dark-green", "index": 8 },
                "11": { "text": "Charging", "color": "green", "index": 9 }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "time series",
          "timeColumns": ["time"],
          "rawQueryText": "SELECT ts AS time, evse_state AS \"state\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts",
          "queryText": "SELECT ts AS time, evse_state AS \"state\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts"
        }
      ]
    },
