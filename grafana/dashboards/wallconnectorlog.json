          "rawQueryText": "SELECT ts AS time, volt_a AS \"A\", volt_b AS \"B\", volt_c AS \"C\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts",
          "queryText": "SELECT ts AS time, volt_a AS \"A\", volt_b AS \"B\", volt_c AS \"C\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts"
