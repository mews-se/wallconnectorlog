      "targets": [
        {
          "refId": "A",
          "queryType": "time series",
          "timeColumns": ["time"],
          "rawQueryText": "SELECT ts AS time, grid_v AS \"voltage\", grid_hz AS \"frequency\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts",
          "queryText": "SELECT ts AS time, grid_v AS \"voltage\", grid_hz AS \"frequency\" FROM sample WHERE ts BETWEEN $__from/1000 AND $__to/1000 ORDER BY ts"
