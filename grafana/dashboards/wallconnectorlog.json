      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 43 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "wcl-sqlite" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "started" },
