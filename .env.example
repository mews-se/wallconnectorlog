# Copy this to .env and set your Wall Connector's address. That is all that is
# required to start:
#
#   cp .env.example .env
#   docker compose up -d

WC_HOST=192.168.1.50

# Local time zone, used for timestamps in the interface.
TZ=Europe/Stockholm

# Polling, retention and backups all have working defaults; README.md lists them
# if you want to change any. The port is set in docker-compose.yml.
